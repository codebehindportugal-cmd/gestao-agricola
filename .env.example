APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# A sessao so termina quando se clica em sair: um ano de validade e o cookie
# a sobreviver ao fechar o browser. Com 120 minutos (o valor por omissao do
# Laravel) o painel deitava fora sozinho depois de duas horas paradas, e os
# formularios rebentavam com 419 "a sessao expirou".
SESSION_DRIVER=database
SESSION_LIFETIME=525600
SESSION_EXPIRE_ON_CLOSE=false
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# Leitura assistida de faturas por IA: desligada. Só liga se quiseres pagar
# por fatura quando o OCR não chegar.
PAPER_INVOICE_CLAUDE=false
CLAUDE_INVOICE_MODEL=claude-sonnet-5

VITE_APP_NAME="${APP_NAME}"

# Notificacoes push (app ntfy no telemovel) - mesmos nomes do painel Ateneya,
# o bloco pode ser copiado tal e qual, topico incluido.
# O topico e a UNICA coisa que protege isto no ntfy.sh publico: quem souber o
# nome le as notificacoes. Nome longo e aleatorio.
NTFY_ENABLED=true
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=
# So se o servidor ntfy exigir autenticacao (o publico nao exige).
# NTFY_TOKEN=
NTFY_TIMEOUT=8
NTFY_AVISA_COMPROMISSOS=true

# Painel de casa (/casa). O go2rtc da rede local serve o video directamente ao
# browser -- o servidor nunca o encaminha, e por isso so' ha imagem dentro de
# casa. Os nomes das camaras tem de coincidir com as chaves de 'streams:' no
# /opt/go2rtc/go2rtc.yaml. Sem cardinal nos valores.
# Direto ao go2rtc (caminho vazio, ele serve na raiz) enquanto o
# casa.codebehind.pt nao existir. So' funciona com o painel aberto em http: a
# partir de https o browser bloqueia o iframe por mixed content.
# Com o Caddy do Passo 1 de pe': CASA_BASE_URL=https://casa.codebehind.pt e
# CASA_CAMINHO_GO2RTC=/go2rtc
CASA_BASE_URL=http://192.168.1.60:1984
CASA_CAMINHO_GO2RTC=
CASA_CAMERAS=entrada,quintal,garagem,lateral
CASA_MODO_VIDEO=webrtc
# CASA_INTERVALO_FEED=5
# CASA_EVENTOS_VISIVEIS=40
# CASA_DIAS_CALENDARIO=14
# CASA_MINUTOS_SEM_CONTACTO=12
# CASA_RETENCAO_DIAS=30
# Ecra sempre ligado: recarga diaria da pagina (vazio desliga) e de quantos em
# quantos minutos reatar os streams, para nao ficar imagem congelada sem aviso.
# CASA_HORA_RECARGA=04:30
# CASA_MINUTOS_CAMARAS=30
